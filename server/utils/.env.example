# Backup archives and metadata. Prefer a separate mounted disk in production.
BACKUP_DIR=./backups
BACKUP_TIME=23:59
BACKUP_TIMEZONE=Asia/Manila
BACKUP_DAILY_RETENTION=14
BACKUP_FULL_RETENTION=4

# Optional explicit paths to the MySQL command-line tools.
# MYSQLDUMP_BIN=mysqldump
# MYSQL_BIN=mysql

# Optional Groq-generated executive guidance. Keep the API key server-side.
# GROQ_API_KEY=
# GROQ_MODEL=

# Base URL of the persistent XLM-RoBERTa service (without /predict).
# ML_SERVICE_URL=http://127.0.0.1:5001
# ML_REQUEST_TIMEOUT_MS=120000
# ML_SERVICE_API_KEY=use-the-same-random-secret-on-the-ML-service
